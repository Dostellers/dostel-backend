# Copy to .env and fill in. Never commit .env.

MONGO_URI=mongodb://localhost:27017/dostel
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Captive portal (DOS-501) ---

# HMAC secret the router uses to verify a grant before opening the walled garden.
# REQUIRED for the portal to issue access. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the value configured on the property router.
PORTAL_GRANT_SECRET=

# Minutes of network access a single grant buys. Default 1440 (24h).
PORTAL_GRANT_MINUTES=1440

# Country code applied to bare local numbers during phone normalization.
PORTAL_DEFAULT_COUNTRY_CODE=91

# Name of the MembershipPlan granted to a captured guest. Must exist and be
# active, or capture still succeeds and membership is skipped with a warning.
PORTAL_ENTRY_PLAN_NAME=Bronze

# Bumped whenever the consent wording changes, so old consents stay auditable
# against the text the guest actually agreed to.
PORTAL_POLICY_VERSION=2026-08-07

# Requests per minute per IP against the unauthenticated portal endpoints.
PORTAL_RATE_LIMIT_MAX=20

# --- Guest memory (DOS-502) ---

# Claude API key for guest-fact extraction. Without it, staff notes are received
# but not extracted.
ANTHROPIC_API_KEY=

# Extraction model and effort. Defaults suit a short mechanical extraction;
# raise effort if subject disambiguation proves unreliable in practice.
GUEST_MEMORY_MODEL=claude-opus-5
GUEST_MEMORY_EFFORT=low

# How many days ahead to include arriving guests in the roster a staff note can
# refer to.
GUEST_MEMORY_LOOKAHEAD_DAYS=3

# Speech-to-text provider for voice notes. UNSET BY DEFAULT AND UNIMPLEMENTED —
# Claude has no audio input, so this needs a separate service chosen for
# code-switched Tamil/Hindi/English. While unset, text notes work and voice notes
# get a reply asking the staff member to type instead.
TRANSCRIPTION_PROVIDER=

# --- WhatsApp (DOS-502; DOS-291 should reuse this surface) ---

# Meta app secret. Signs the webhook body — without it every webhook is
# rejected, because the endpoint would otherwise be a public write to guest
# records.
WHATSAPP_APP_SECRET=

# Token echoed back during Meta's subscription handshake. Any random string,
# matching what you enter in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=

# Sending credentials, for replies back to staff.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Staff permitted to write guest facts, as comma-separated `number:name` pairs.
# A message from any other number is ignored. The name is stamped on every fact
# as capturedBy, so keep it recognisable.
WHATSAPP_STAFF_NUMBERS=9876543210:Anand (reception),9876543211:Meera (manager)

# --- Reliability telemetry (DOS-503) ---

# On-property devices permitted to report, as comma-separated `deviceId:secret`
# pairs. Each device gets its own key so one can be rotated without re-keying the
# property. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEMETRY_DEVICE_KEYS=

# Maximum observations in one batch.
TELEMETRY_MAX_BATCH=5000

# How far back a buffered device may backfill. Older observations are rejected as
# a clock fault: a wrong timestamp silently corrupts a published number, whereas
# silence only shows up as a coverage gap.
TELEMETRY_MAX_BACKFILL_DAYS=14

# How long one observation is taken to speak for. Beyond this the interval counts
# as unknown rather than a continuation of the last known state — this is what
# stops a dead sensor reading as perfect uptime.
RELIABILITY_MAX_GAP_MINUTES=20

# Coverage below which a window's uptime figure is marked unpublishable. 100%
# uptime at 40% coverage is not a claim worth making.
RELIABILITY_MIN_COVERAGE_PCT=80
